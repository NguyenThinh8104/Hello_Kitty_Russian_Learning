{
  "name": "nga-ngo-app",
  "version": "1.0.0",
  "private": true,
  "description": "Russian Kitty — luyện tiếng Nga A1 theo I Love Russian 2017",
  "author": "Russian Kitty",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build && node scripts/bundle-private.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "desktop": "electron .",
    "windows": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/file-viewer": "2.0.4",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.2",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-speech-recognition": "8.6.0",
    "capacitor-voice-recorder": "7.0.6"
  },
  "devDependencies": {
    "@babel/parser": "8.1.3",
    "@capacitor/cli": "8.6.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "vn.russiankitty.a1",
    "productName": "Russian Kitty",
    "directories": {
      "output": "../artifacts/native"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/providers.mjs",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "../NgaNgo.Web/wwwroot/icons/russian-kitty.ico",
      "signExecutable": false
    }
  }
}
